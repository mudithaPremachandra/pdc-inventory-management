
POSTGRES_USER=inventory
POSTGRES_PASSWORD=inventory
POSTGRES_DB=inventory

# Shared by command-api and query-api to sign/verify login tokens.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRY_MINUTES=120

# First admin account, created on command-api startup if it does not exist yet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Time zone the CLI shows times in (stored times are always UTC).
TZ=Asia/Colombo
